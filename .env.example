# Copy thành .env rồi đổi giá trị. KHÔNG commit file .env

# --- dùng chung ---
TRACKER_URL=http://127.0.0.1:8000
TRACKER_TOKEN=change-me-to-a-long-random-string

# --- tracker ---
TRACKER_HOST=0.0.0.0
TRACKER_PORT=8000
PEER_TTL=10              # giây: quá thời gian này không announce thì coi như peer đã rời mạng
ANNOUNCE_INTERVAL=2      # giây: chu kỳ heartbeat tracker yêu cầu peer

# --- peer (mỗi peer một PEER_ID và PEER_PORT riêng) ---
PEER_ID=peer-1
PEER_HOST=127.0.0.1      # địa chỉ peer khác dùng để kết nối tới mình
BIND_HOST=0.0.0.0
PEER_PORT=9001
MAX_PARALLEL=4           # số chunk tải cùng lúc
PER_PEER_LIMIT=2         # số request đồng thời tới một peer
MAX_UPLOADS=8            # số kết nối upload phục vụ cùng lúc
CHUNK_TIMEOUT=5
MAX_RETRIES=3
UPLOAD_DELAY=0           # giây/chunk, giả lập băng thông (demo)
CORRUPT_RATE=0           # CHỈ ĐỂ DEMO: tỉ lệ cố tình gửi chunk hỏng

# --- chỉ dùng khi chạy bằng Docker (deploy/docker-compose.yml) ---
# File mà peer2, peer3, peer4 tự tải khi khởi động: 16 ký tự hex, là giá trị peer1 in ra ở dòng FILE_ID=...
# Để trống thì các peer hỏi tracker và tải file đầu tiên có trên đó.
FILE_ID=
